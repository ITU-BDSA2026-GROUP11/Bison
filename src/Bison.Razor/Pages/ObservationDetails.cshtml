@page "/ob/{id:int}"
@model Bison.Razor.Pages.ObservationDetailsModel

@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
    var obs = Model.Observation!;

    // Hide emails and missing display names
    bool HasDisplayName(string? author) =>
        !string.IsNullOrWhiteSpace(author)
        && !author.Contains('@')
        && !string.Equals(author, "Unknown user", StringComparison.OrdinalIgnoreCase);
}

<div>
    <h2>Observation</h2>

    <ul id="messagelist" class="observations">
        <li>
            <p>
                <strong>
                    @if (HasDisplayName(obs.Author))
                    {
                        <a href="/obs/@Uri.EscapeDataString(obs.Author!)">@obs.Author</a>
                    }
                    else
                    {
                        <span>Unknown user</span>
                    }
                </strong>

                @obs.Text
                <small>&mdash; @obs.TimeStamp</small>
            </p>
            @if (!string.IsNullOrWhiteSpace(obs.ImgPath))
            {
            <img src="/@obs.ImgPath" alt="Image" width="350" />
            }
        </li>
    </ul>

    <h3>Proposals</h3>

    @if (Model.Proposals.Any())
    {
        <ul id="proposallist" class="observations">
            @foreach (var proposal in Model.Proposals)
            {
                var taxonName = Model.TaxonNames.TryGetValue(
                    proposal.TaxonId, out var name)
                    ? name
                    : $"Taxon {proposal.TaxonId}";

                <li>
                    <p>
                        <strong>
                            @if (HasDisplayName(proposal.Author))
                            {
                                <a href="/obs/@Uri.EscapeDataString(proposal.Author!)">@proposal.Author</a>
                            }
                            else
                            {
                                <span>Unknown user</span>
                            }
                        </strong>

                        proposes <em>@taxonName</em>

                        @if (!string.IsNullOrWhiteSpace(proposal.Text))
                        {
                            <span>: @proposal.Text</span>
                        }

                        <small>&mdash; @proposal.TimeStamp</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no proposals for this observation so far.</em>
    }

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="observationbox">
            <h3>Propose another animal</h3>

            <form method="post" asp-page-handler="Proposal" asp-route-id="@obs.PostId">

                <select asp-for="ProposalTaxonId" asp-items="Model.TaxonOptions">
                    <option value="">-- choose a taxon --</option>
                </select>

                <input style="float: left" type="text" asp-for="ProposalText" placeholder="Why? (optional)" />

                <input type="submit" value="Propose" />
            </form>

            @if (Model.ProposalError != null)
            {
                <p role="alert" style="color: red; clear: both">
                    @Model.ProposalError
                </p>
            }
        </div>
    }
    else
    {
        <p>
            <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@($"/ob/{obs.PostId}")">Log in</a>
            to propose another animal.
        </p>
    }

    <h3>Comments</h3>

    @if (Model.Comments.Any())
    {
        <ul id="commentlist" class="observations">
            @foreach (var comment in Model.Comments)
            {
                <li>
                    <p>
                        <strong>
                            @if (HasDisplayName(comment.Author))
                            {
                                <a href="/obs/@Uri.EscapeDataString(comment.Author!)">@comment.Author</a>
                            }
                            else
                            {
                                <span>Unknown user</span>
                            }
                        </strong>

                        @comment.Text
                        <small>&mdash; @comment.TimeStamp</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no comments for this observation so far.</em>
    }

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="observationbox">
            <h3>Add a comment</h3>

            <form method="post" asp-page-handler="Comment" asp-route-id="@obs.PostId">

                <input style="float: left" type="text" asp-for="CommentText" />

                <input type="submit" value="Comment" />
            </form>

            @if (Model.CommentError != null)
            {
                <p role="alert" style="color: red; clear: both">
                    @Model.CommentError
                </p>
            }
        </div>
    }
    else
    {
        <p>
            <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@($"/ob/{obs.PostId}")">Log in</a>
            to add a comment.
        </p>
    }
</div>
