@page "/"
@model Bison.Razor.Pages.PublicModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";

    // Keeps the taxon filter in the paging links
    var taxonQuery = Model.SelectedTaxonId.HasValue ? $"&taxon={Model.SelectedTaxonId}" : "";
}

<div>
    <h2> Public Timeline </h2>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="observationbox">
            <h3>What did you see, @(User.Identity.Name)?</h3>
            <form method="post" enctype="multipart/form-data">
                <input style="float: left" type="text" asp-for="Text" name="InputObs" data-testid="observation-text" />
                <select asp-for="SelectedTaxonId" data-testid="observation-taxon">
                    <option value="">Select a taxon...</option>
                    @foreach (var taxon in Model.Taxa)
                    {
                        <option value="@taxon.TaxonId">@taxon.Name</option>
                    }
                </select>
                <input type="file" id="imageFile" asp-for="InputPhoto" name="InputPhoto" onchange="return imageValidation()" />
                <input type="submit" value="Share" data-testid="observation-submit" />
            </form>

        </div>
    }
            
       

    <form method="get" class="taxon-filter">
        <label for="taxon">Filter by taxon:</label>
        <select id="taxon" name="taxon" onchange="this.form.submit()">
            <option value="">All taxa</option>
            @foreach (var taxon in Model.Taxa)
            {
                <option value="@taxon.TaxonId" selected="@(taxon.TaxonId == Model.SelectedTaxonId)">@taxon.Name</option>
            }
        </select>
        <noscript><button type="submit">Filter</button></noscript>
    </form>

    @if (Model.SelectedTaxonName != null)
    {
        <p>
            Showing observations of <strong>@Model.SelectedTaxonName</strong> and its subtaxa.
            <a href="/">Show all</a>
        </p>
    }

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@obs.Author">@obs.Author</a>
                        </strong>
                        @obs.Text
                        <small>&mdash; <a href="/ob/@obs.PostId">@obs.TimeStamp</a></small>
                    </p>
                    @if (!string.IsNullOrEmpty(obs.ImgPath))
                        {
                        //string path = "/" + @obs.ImgPath;
                        <img src="@obs.ImgPath" alt="Image" width="250px" />
                        }
                    
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }
    @if (Model.CurrentPage > 1)
    {
        <a href="?page=@(Model.CurrentPage - 1)@taxonQuery">Previous</a>
    }

    <a href="?page=@(Model.CurrentPage + 1)@taxonQuery">Next</a>
</div>

<script>
    function imageValidation() {
    var imageInput = document.getElementById('imageFile');
    var imagePath = imageInput.value;
    var validExtensions = /(\.jpg|\.jpeg|\.png)$/i;

    if(!validExtensions.exec(imagePath)){
        alert('Please upload a .png, .jpg, or .jpeg file');
        imageInput.value = '';
        return false;
    }
    else{
        return true;
    }
    }
</script>