@using Bison.Razor.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<Author> UserManager
@{
    var currentAuthor = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    var authorRouteName = !string.IsNullOrWhiteSpace(currentAuthor?.Name) ? currentAuthor.Name : User.Identity?.Name ?? "";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <title>@ViewData["Title"]</title>
    <link href="/css/style.css" rel="stylesheet" type="text/css" />
    <link rel="icon" type="image/png" href="/favicon/favicon.ico">
</head>

<body>
    <div class="page">

        <h1><img src="/images/icon1.png" alt="Icon1" />Bison</h1>

        <div class="navigation">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="/@(Uri.EscapeDataString(authorRouteName))">My Observations</a>
                <a href="/">Public Observations</a>

                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post"
                      style="display:inline">
                    <button type="submit">Logout [@(User.Identity?.Name)]</button>
                </form>
            }
            else
            {
                <a href="/">Public Observations</a>
                <a asp-area="Identity" asp-page="/Account/Register">Register</a>
                <a asp-area="Identity" asp-page="/Account/Login">Login</a>
            }
        </div>

        <div class="body">
            @RenderBody()
        </div>

        <div class="footer">
            Bison &mdash; An ASP.NET Application
        </div>

    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>